# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── GHL (GoHighLevel) ─────────────────────────────────────────────────────────
# Agency-level API key (rotate every 90 days)
GHL_API_KEY=
GHL_LOCATION_ID=               # Default location; agents pass building-specific IDs at runtime

# ── Microsoft 365 ─────────────────────────────────────────────────────────────
# App registration in Azure AD (rotate secret every 180 days)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SHAREPOINT_SITE_ID=       # e.g. zenresidential.sharepoint.com,<site-guid>,<web-guid>
M365_TEAMS_CHANNEL_MARKET=     # #market-intelligence channel webhook URL
M365_TEAMS_CHANNEL_DIGITAL=    # #digital-ops channel webhook URL
M365_TEAMS_CHANNEL_REPUTATION= # #reputation channel webhook URL
M365_TEAMS_CHANNEL_TECHOPS=    # #tech-ops channel webhook URL
M365_TEAMS_CHANNEL_ESCALATIONS=# #escalations channel webhook URL
M365_YARDI_MAILBOX=            # yardi-data@zenresidential.ca mailbox ID for Graph

# ── RentSync ──────────────────────────────────────────────────────────────────
RENTSYNC_API_KEY=              # Rotate every 90 days

# ── WordPress ─────────────────────────────────────────────────────────────────
WORDPRESS_BASE_URL=            # https://zenresidential.ca
WORDPRESS_APP_PASSWORD=        # Application password (rotate every 90 days)
WORDPRESS_USERNAME=            # WP admin username

# ── PostgreSQL (Railway-provisioned) ──────────────────────────────────────────
DATABASE_URL=                  # Injected automatically on Railway

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
