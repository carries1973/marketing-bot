# ── PCG Test Environment ─────────────────────────────────────────────────────
# Copy this to .env to run the PCG test environment.
# Yardi reports email to: carrie@propertyconsultinggroup.ca
# Notifications go to: carrie@propertyconsultinggroup.ca via Gmail

NOTIFICATION_PROVIDER=google
NOTIFY_EMAIL=carrie@propertyconsultinggroup.ca

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── GHL — PCG account ────────────────────────────────────────────────────────
# Private Integration Token (PIT) — use this as GHL_API_KEY for private integrations
GHL_API_KEY=pit-07426fcb-2a35-461a-8d8a-019b83bd0756
GHL_LOCATION_ID=t8XF6CbsKa87yJXHlNFU
GHL_PIPELINE_ID=6KY2qkzmz9bJvZ2houkh

# ── Google Workspace ──────────────────────────────────────────────────────────
# Get these from Google Cloud Console → OAuth 2.0 credentials
# Run: node scripts/google-auth.js  to generate the refresh token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Drive folder IDs (right-click folder in Drive → Get link → copy ID from URL)
GOOGLE_DRIVE_YARDI_FOLDER_ID=                          # Parent "Yardi Data" folder (not created yet)
GOOGLE_DRIVE_YARDI_VACANCY_FOLDER_ID=1ZunA0OUpiMOxiwM0slOg2mlG2r-EfNNm
GOOGLE_DRIVE_YARDI_RENTROLL_FOLDER_ID=1pgFHDX6Ny9a7idAmhBPea55yGVHAIYCU
GOOGLE_DRIVE_YARDI_FINANCIAL_FOLDER_ID=1SLnmr8P0YauwwgR0Uvj2UCeqm3b7CsQ5
GOOGLE_DRIVE_YARDI_LEASING_FOLDER_ID=                  # Not created yet
GOOGLE_DRIVE_REPORTS_FOLDER_ID=1JHpbeFWFfHpd6VK4hLvAq3AAmkuXncJ5

# ── RentSync (optional for initial test) ─────────────────────────────────────
RENTSYNC_API_KEY=

# ── WordPress — propertyconsultinggroup.ca ────────────────────────────────────
WORDPRESS_BASE_URL=https://propertyconsultinggroup.ca
WORDPRESS_APP_PASSWORD=
WORDPRESS_USERNAME=

# ── PostgreSQL (Railway-provisioned) ──────────────────────────────────────────
DATABASE_URL=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
